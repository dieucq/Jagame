{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game.jagame.vn/schema/manifest-2.json",
  "title": "Jagame — manifest.json của 1 gói game (v1 + v2)",
  "description": "Dùng chung cho devkit `jagame check`, build kho (jgame.py), kiểm khi nộp, kiểm khi chủ nhà cài thủ công. CHUAN-GIAO-TIEP.md Bộ kiểm chỉ dùng tập con JSON Schema: type, required, properties, additionalProperties, enum, const, pattern, minimum, maximum, minLength, maxLength, minItems, maxItems, uniqueItems, items, anyOf, $ref (#/$defs/…). Luật chéo (default ∈ choices, min ≤ max, tick_ms ↔ mode, file tồn tại, icon/ảnh hợp lệ) nằm trong mã bộ kiểm. Manifest có \"manifest\": 2 bị kiểm CHẶT (sai = trượt); manifest v1 (không có trường này) sai schema chỉ CẢNH BÁO.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api",
    "app_min",
    "group",
    "players",
    "desc",
    "age",
    "icon",
    "entry",
    "changelog"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "const": 2,
      "description": "Phiên bản định dạng manifest. Có = kiểm chặt theo v2; thiếu = manifest v1 (tương thích)."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "Mã duy nhất toàn kho, không bao giờ đổi; = tên thư mục game."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$",
      "description": "semver X.Y.Z; bản mới phải lớn hơn; đã phát hành thì byte gói bất biến."
    },
    "api": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "API máy (runtime) — hiện 1. Giao thức v2 + SDK chạy trên API 1."
    },
    "sdk": {
      "enum": [
        "2"
      ],
      "description": "Khai = công cụ gộp shared/sdk (jg-core trước server, jg-ui trước client) vào gói lúc đóng gói."
    },
    "app_min": {
      "$ref": "#/$defs/semver",
      "description": "Phiên bản Jagame tối thiểu (= min_platform)."
    },
    "group": {
      "enum": [
        "co",
        "dangian",
        "vui",
        "bai"
      ],
      "description": "Nhóm/chuyên mục: co = Các loại cờ, dangian = Trò dân gian, vui = Trò vui cả nhà, bai = Bài lá."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "players": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "teams": {
      "type": "object",
      "required": [
        "count",
        "size"
      ],
      "additionalProperties": false,
      "description": "Tùy chọn: chơi theo đội (count đội × size người). Khung hiện chưa xếp đội — game tự chia theo ghế.",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "spectators": {
      "type": "boolean"
    },
    "desc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "age": {
      "type": "integer",
      "minimum": 3,
      "maximum": 18,
      "description": "Độ tuổi tối thiểu (xếp loại nội dung)."
    },
    "content": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {
        "enum": [
          "dau-ao",
          "so-hai",
          "chu-nguoi-choi",
          "ve-tu-do",
          "an-vai",
          "tinh-gio"
        ]
      },
      "description": "Nhãn nội dung: dau-ao = đậu ảo không tiền thật · so-hai = có yếu tố đáng sợ · chu-nguoi-choi = người chơi gõ chữ cho nhau xem · ve-tu-do = người chơi vẽ tự do · an-vai = nhập vai lừa gạt (ma sói) · tinh-gio = áp lực thời gian."
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "icon": {
      "enum": [
        "icon.svg",
        "icon.png"
      ],
      "description": "SVG vuông (viewBox w=h, XML hợp lệ, không script/on*/href ngoài) hoặc PNG vuông 256–1024 px (khuyên 512). ≤ 200 KB."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^screenshots/[A-Za-z0-9._-]{1,60}\\.(png|jpg|jpeg|webp)$"
      },
      "description": "Ảnh chụp (dọc ~3:4 khuyên dùng), mỗi ảnh ≤ 400 KB, cạnh 320–2400 px."
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://[^\\s]{4,200}$"
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "maxLength": 40
    },
    "howto": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "news": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "\"Có gì mới\" ≤ 3 dòng cho người chơi (changelog để cho nhật ký kỹ thuật)."
    },
    "changelog": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "required": [
        "client",
        "server"
      ],
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "pattern": "^client/[A-Za-z0-9._@+/-]{1,120}\\.js$"
        },
        "server": {
          "type": "string",
          "pattern": "^server/[A-Za-z0-9._@+/-]{1,120}\\.js$"
        },
        "style": {
          "type": "string",
          "pattern": "^client/[A-Za-z0-9._@+/-]{1,120}\\.css$"
        }
      }
    },
    "mode": {
      "description": "Cách giao tiếp/nhịp chơi (thay cho tên `comm`; dải \"Cách chơi\" ở chợ). Một giá trị hoặc mảng kết hợp: turn = theo lượt (view.turn) · simultaneous = mọi người hành động cùng lúc · realtime = máy tiến theo nhịp tick (cần tick_ms) · events = luồng sự kiện nhỏ (cần ui.events). Thiếu → suy từ trường cũ (tick_ms → realtime, ui.events → events, bot_simultaneous → simultaneous, còn lại turn).",
      "anyOf": [
        {
          "$ref": "#/$defs/modeValue"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modeValue"
          }
        }
      ]
    },
    "tick_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "description": "Game hành động thời gian thực (mode \"action\", CHUAN-GIAO-TIEP.md): luật THƯỜNG TRÚ trong 1 worker/phòng, khung chạy nhịp + gửi ảnh chụp theo vùng nhìn.",
      "properties": {
        "tick_hz": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60,
          "description": "nhịp mô phỏng/giây (30)"
        },
        "send_hz": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "description": "ảnh chụp/giây cho người chơi (15), ≤ tick_hz"
        },
        "view": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 8,
            "maximum": 64
          },
          "description": "vùng nhìn mặc định [rộng, cao] theo ô (32×48); client đổi bằng game.viewSize, khung kẹp 8..64"
        },
        "world": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 8,
            "maximum": 4096
          },
          "description": "kích thước sân [W, H] theo ô (tùy chọn — không khai thì khung đọc W/H trong world())"
        },
        "unit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "đơn vị tọa độ / 1 ô (8): me[0], me[1] chia unit = ô tâm vùng nhìn"
        },
        "input": {
          "type": "object",
          "maxProperties": 8,
          "description": "khóa input → [min, max] số nguyên (mặc định {\"d\":[-1,3],\"f\":[0,1]}); thứ tự khóa = thứ tự trong gói game:in; khóa ĐẦU là hướng (lặp khi đói gói)",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          }
        },
        "delta": {
          "type": "object",
          "description": "trường mảng phẳng của snapshot → số phần tử/thực thể (phần tử đầu = id): khung chỉ gửi thực thể đổi",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "minutes"
      ],
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          }
        }
      },
      "description": "Độ dài 1 ván ước tính [ít nhất, nhiều nhất] phút."
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Quyền/nhu cầu phía trình duyệt — chợ hiện cho chủ nhà biết. Mặc định false.",
      "properties": {
        "sound": {
          "type": "boolean"
        },
        "vibrate": {
          "type": "boolean"
        },
        "storage": {
          "type": "boolean",
          "description": "Ghi localStorage (khóa tiền tố jg_<id>_)."
        },
        "user_text": {
          "type": "boolean",
          "description": "Người chơi gõ chữ hiển thị cho người khác (qua lọc từ của máy)."
        }
      }
    },
    "bot": {
      "type": "boolean"
    },
    "bot_simultaneous": {
      "type": "boolean"
    },
    "clock": {
      "anyOf": [
        {
          "const": true
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([1-9]|[1-9][0-9]|1[0-7][0-9]|180)\\+([0-9]|[1-5][0-9]|60)$"
          }
        }
      ]
    },
    "resume": {
      "type": "boolean",
      "description": "false = ván không khôi phục được sau khi máy chủ khởi động lại (game giữ trạng thái ngoài state). Mặc định true."
    },
    "scored": {
      "type": "boolean",
      "description": "false = gói KHÔNG tính điểm (ứng dụng: chia đội, bình chọn…): mọi kết thúc là \"Xong phiên\" — không thắng/thua/hòa, không thống kê, xếp hạng, huy hiệu, tim thưởng. Mặc định true. Cần app_min ≥ 0.4.0 (bản Jagame đầu tiên có trường này, chuẩn 2.2). Từng phiên cũng khai được bằng Result.scored = false."
    },
    "undo": {
      "type": "boolean"
    },
    "undo_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "hint": {
      "type": "boolean"
    },
    "hint_max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "tutorial": {
      "description": "Hướng dẫn lần đầu (khung vẽ): 1–8 bước, mỗi bước là chữ hoặc {text, at?: selector, title?}; hoặc {steps:[…]}.",
      "anyOf": [
        {
          "$ref": "#/$defs/tutorialSteps"
        },
        {
          "type": "object",
          "required": [
            "steps"
          ],
          "additionalProperties": false,
          "properties": {
            "steps": {
              "$ref": "#/$defs/tutorialSteps"
            }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "players": {
          "enum": [
            "game",
            "frame"
          ]
        },
        "events": {
          "type": "boolean"
        },
        "end": {
          "enum": [
            "game",
            "frame"
          ]
        },
        "fullscreen": {
          "type": "boolean",
          "description": "game hành động chiếm trọn màn điện thoại khi đang chơi: khung ẩn đầu trang/ghế/💬😀/thanh Đầu hàng (game tự vẽ nút chat qua game.openChat)"
        },
        "end_banner": {
          "type": "boolean",
          "description": "ui.end = \"game\" mà vẫn muốn khung hiện banner Thắng/Thua gọn"
        }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "choices",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/choice"
            }
          },
          "default": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "reasons": {
      "type": "object",
      "maxProperties": 20,
      "description": "Lý do kết thúc RIÊNG của game (ngoài danh sách chuẩn): mã → {text: phụ đề tiếng Việt, by: winner|loser|none}.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "text",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "by": {
            "enum": [
              "winner",
              "loser",
              "none"
            ]
          }
        }
      }
    },
    "soon": {
      "type": "boolean"
    },
    "unlisted": {
      "type": "boolean"
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "description": "Phòng: dropin = vào/ra GIỮA ván (khung gọi join/leave, không huỷ ván, không xử thua); persist = phòng không tự đóng khi trống lúc ván chạy. Game hành động luôn dropin + persist.",
      "properties": {
        "dropin": {
          "type": "boolean"
        },
        "persist": {
          "type": "boolean"
        },
        "teams": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "names": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "balance": {
              "enum": [
                "auto",
                "none"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "modeValue": {
      "enum": [
        "turn",
        "simultaneous",
        "realtime",
        "events",
        "action"
      ]
    },
    "choice": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 40
        }
      ]
    },
    "tutorialStep": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "at": {
              "type": "string",
              "maxLength": 120
            },
            "title": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      ]
    },
    "tutorialSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/tutorialStep"
      }
    }
  }
}
